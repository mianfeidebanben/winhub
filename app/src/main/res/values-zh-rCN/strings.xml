    <string name="you_cannot_remove_this_preset">您不能删除这个预设</string>
    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> 是一个将 DirectX 1-11 转换为 OpenGL 的翻译层。<br /><br />
        <i><b>DXVK</b></i> 是一个将 Direct3D 9-11 转换为 Vulkan 的翻译层。<br /><br />
        <i><b>VEGAS</b></i> 是 DXVK 的性能优化分支，针对 Android/Adreno 设备提供游戏专属优化。<br /><br />
        <i><b>VKD3D</b></i> 是一个将 Direct3D 12 API 转换为 Vulkan 的翻译层。<br /><br />
        <i><b>CNC DDraw</b></i> 是 DirectDraw 的实现，可提升经典游戏的兼容性。
    ]]></string>
    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
        CALL/RET 操作码的标志位处理<br /><br />
        <b>0</b>：将 CALL/RET 视为不需要标志位（更快，不稳定）<br />
        <b>1</b>：大多数 RET 需要标志位，大多数 CALL 不需要<br />
        <b>2</b>：所有 CALL/RET 都需要标志位（更慢）
    ]]></string>
    <string name="box64_env_var_help__dynarec_fastnan">像 x86 一样生成 -NAN</string>
    <string name="box64_env_var_help__dynarec_fastround">生成精确的 x86 舍入</string>
    <string name="box64_env_var_help__dynarec_x87double">在 x87 模拟中使用 Float/Double</string>
    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec 构建 BigBlock<br /><br />
        <b>0</b>：不尝试构建尽可能大的块<br />
        <b>1</b>：将 Dynarec 块构建得尽可能大<br />
        <b>2</b>：构建更大的 Dynarec 块（块重叠时继续，但仅限 ELF 内存中的块）<br />
        <b>3</b>：构建更大的 Dynarec 块（块重叠时继续，适用于所有类型的内存）
    ]]></string>
    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
        强内存模型模拟<br /><br />
        <b>0</b>：不做任何特殊处理<br />
        <b>1</b>：写入内存时（某些 MOV 操作码）启用部分内存屏障<br />
        <b>2</b>：在 1 的基础上，每次用 MOV 写入内存时都加内存屏障<br />
        <b>3</b>：在 2 的基础上，读取内存时以及某些 SSE/SSE2 操作码上再加内存屏障
    ]]></string>
    <string name="box64_env_var_help__dynarec_forward">定义构建块时允许的最大前向值</string>
    <string name="box64_env_var_help__dynarec_callret">CALL/RET 操作码的优化</string>
    <string name="box64_env_var_help__dynarec_wait">定义 Dynarec 是否等待 FillBlock 就绪</string>
    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
        调整内存屏障以减少强内存模拟的性能影响<br /><br />
        <b>0</b>：使用常规安全屏障<br />
        <b>1</b>：使用弱屏障以获得轻微性能提升<br />
        <b>2</b>：使用弱屏障，并额外禁用最后的写入屏障
    ]]></string>
    <string name="box64_env_var_help__dynarec_aligned_atomics"><![CDATA[
        仅生成对齐的原子操作（目前仅在 Arm64 上可用）。<br /><br />
        <b>0</b>：生成非对齐原子操作的处理代码。<br />
        <b>1</b>：仅生成对齐的原子操作，速度更快、代码更小，但对作用于对齐数据地址的 LOCK 前缀操作码会引发 SIGBUS。
    ]]></string>
    <string name="box64_env_var_help__dynarec_df"><![CDATA[
        启用或禁用延迟标志（deferred flags）。<br /><br />
        <b>0</b>：禁用延迟标志。<br />
        <b>1</b>：启用延迟标志。
    ]]></string>
    <string name="box64_env_var_help__dynarec_dirty"><![CDATA[
        允许继续运行未受保护且可能已脏的块。<br /><br />
        <b>0</b>：不允许继续运行未受保护且可能已脏的块。<br />
        <b>1</b>：允许继续运行在代码所在同一页写入数据的 dynablock。可加快某些游戏的加载速度，但也可能导致意外崩溃。<br />
        <b>2</b>：当检测到热点页（HotPage）时，将该页标记为 NEVERCLEAN，使其不受写保护，但从该页构建的块始终会被检测。这样可能更快（但某些 SMC 情况可能无法被捕获）。
    ]]></string>
    <string name="box64_env_var_help__dynarec_nativeflags"><![CDATA[
        启用或禁用原生标志（native flags）。<br /><br />
        <b>0</b>：不使用原生标志。<br />
        <b>1</b>：尽可能使用原生标志。
    ]]></string>
    <string name="box64_env_var_help__dynarec_pause"><![CDATA[
        启用 x86 PAUSE 模拟，可能有助于自旋锁的性能。<br /><br />
        <b>0</b>：忽略 x86 PAUSE 指令。<br />
        <b>1</b>：使用 YIELD 模拟 x86 PAUSE 指令。<br />
        <b>2</b>：使用 WFI 模拟 x86 PAUSE 指令。<br />
        <b>3</b>：使用 SEVL+WFE 模拟 x86 PAUSE 指令。
    ]]></string>
    <string name="box64_env_var_help__avx"><![CDATA[
        实现了 AVX 和 AVX2，以及 BMI1、BMI2、ADX、FMA、F16C 和 RDANDR 扩展！<br /><br />
        <b>0</b>：禁用 AVX 扩展<br />
        <b>1</b>：启用 AVX、BMI1、F16C 和 VAES 扩展。<br />
        <b>2</b>：在 1 的基础上启用 AVX2、BMI2、FMA、ADX、VPCLMULQDQ 和 RDRAND。<br />
    ]]></string>
    <string name="box64_env_var_help__maxcpu">Box64 向程序呈现的最大 CPU 数量</string>
    <string name="box64_env_var_help__unityplayer">检测 UnityPlayer.dll 并应用 strongmem 设置</string>
    <string name="box64_env_var_help__mmap32">强制所有内存分配使用 32 位地址空间</string>
    <string name="fexcore_env_var_help__tsoenabled">启用 TSO IR 操作（多线程应用必需）。</string>
    <string name="fexcore_env_var_help__vectortsoenabled">启用 TSO 时使向量加载/存储变为原子操作。</string>
    <string name="fexcore_env_var_help__halfbarriertsoenabled">在 TSO 下对非对齐加载/存储使用半屏障原子操作。</string>
    <string name="fexcore_env_var_help__memcpysettsoenabled">在 TSO 下使 REP MOVS / REP STOS 变为原子操作。</string>
    <string name="fexcore_env_var_help__multiblock">启用多块代码编译。可能导致 JIT 编译时间更长和卡顿。</string>
    <string name="fexcore_env_var_help__hostfeatures">控制 CPU 特性的强制启用。</string>
    <string name="fexcore_env_var_help__smalltscscale">在低频系统上缩放 TSC。</string>
    <string name="fexcore_env_var_help__smc_checks">自修改代码检查。</string>
    <string name="fexcore_env_var_help__volatilemetadata">在可用时使用 PE 文件中的 volatile 元数据来处理 TSO。</string>
    <string name="fexcore_env_var_help__monohacks">用于 Mono 检测的特殊 SMC + JIT 块 hack。</string>
    <string name="fexcore_env_var_help__hidehypervisorbit">隐藏 CPUID 虚拟机监控位（对因此崩溃的应用有用）。</string>
    <string name="fexcore_env_var_help__disablel2cache">禁用 FEXCore JIT L2 缓存查找，节省内存但会引入卡顿。</string>
